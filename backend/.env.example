# Copy to .env for local development. Never commit .env.
GO_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres@localhost:5432/betelite?sslmode=disable
ADMIN_EMAIL=dev-admin@example.com
APP_URL=http://localhost:3000

# Leave Firebase empty locally to use ?dev=<name> test logins.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash

# Backup screenshot reader (Claude). Leave empty to use Gemini only.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
OCR_PROVIDERS=gemini,claude

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY_GH=
PAYSTACK_SECRET_KEY_GH=

# Flutterwave (v3 keys). Tried first; Paystack is the fallback.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# The "secret hash" you set in Flutterwave > Settings > Webhooks
FLUTTERWAVE_WEBHOOK_HASH=
# Set to true once Flutterwave enables GHS (Ghana mobile money) on your account
FLUTTERWAVE_GHS=false
PAYMENT_PROVIDERS=flutterwave,paystack
# Exchange margin on cross-currency payments and wallet moves (percent)
FX_MARGIN_PCT=3
# Optional fixed naira-per-cedi rate; leave empty to use the market rate
FX_NGN_PER_GHS=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
