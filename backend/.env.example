# Copy to .env for local development. Never commit .env.
GO_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres@localhost:5432/betelite?sslmode=disable
ADMIN_EMAIL=dev-admin@example.com
APP_URL=http://localhost:3000

# Leave Firebase empty locally to use ?dev=<name> test logins.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash

# Backup screenshot reader (Claude). Leave empty to use Gemini only.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
OCR_PROVIDERS=gemini,claude

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY_GH=
PAYSTACK_SECRET_KEY_GH=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
